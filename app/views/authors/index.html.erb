<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-slate-900">Authors</h1>
  <%= link_to "+ Add Author", new_author_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-indigo-500 text-sm" %>
</div>

<div class="bg-white rounded-2xl border border-slate-200 divide-y divide-slate-100">
  <% @authors.each do |author| %>
    <div class="flex items-center justify-between p-5">
      <div>
        <%= link_to author.name, author_path(author), class: "font-medium text-slate-900 hover:text-indigo-600" %>
        <p class="text-sm text-slate-500 mt-0.5"><%= pluralize(author.books.count, "book") %></p>
      </div>
      <div class="flex gap-2 text-sm">
        <%= link_to "Edit", edit_author_path(author), class: "text-slate-500 hover:text-indigo-600 font-medium" %>
        <%= button_to "Delete", author_path(author), method: :delete,
              form: { data: { turbo_confirm: "Delete this author?" } },
              class: "text-rose-500 hover:text-rose-700 font-medium bg-transparent p-0" %>
      </div>
    </div>
  <% end %>
</div>

<% if @authors.empty? %>
  <div class="text-center py-16 text-slate-400">No authors yet.</div>
<% end %>

<div class="mt-8 flex justify-center"><%= paginate @authors %></div>
