<div class="mb-4">
  <%= link_to "&larr; Back to authors".html_safe, authors_path, class: "text-sm text-slate-500 hover:text-indigo-600" %>
</div>
<div class="bg-white rounded-2xl border border-slate-200 p-8 mb-6">
  <h1 class="text-2xl font-bold text-slate-900"><%= @author.name %></h1>
  <p class="text-slate-600 mt-3 leading-relaxed"><%= @author.bio.presence || "No biography available." %></p>
</div>

<h2 class="text-lg font-semibold text-slate-900 mb-3">Books by <%= @author.name %></h2>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
  <% @books.each do |book| %>
    <%= link_to book_path(book), class: "block bg-white rounded-xl border border-slate-200 p-4 hover:shadow-md" do %>
      <p class="font-medium text-slate-900"><%= book.title %></p>
      <p class="text-xs text-slate-400 mt-1"><%= book.category.name %></p>
    <% end %>
  <% end %>
</div>
