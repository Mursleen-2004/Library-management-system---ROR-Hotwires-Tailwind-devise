<div class="max-w-md mx-auto bg-white rounded-2xl border border-slate-200 p-8 mt-8">
  <h1 class="text-2xl font-bold text-slate-900 mb-6">Create your account</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :name, autofocus: true, class: "w-full rounded-lg border px-3 py-2
text-slate-900  border-slate-300 bg-white focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.email_field :email, autocomplete: "email", class: "w-full rounded-lg border px-3 py-2
text-slate-900 border-slate-300 bg-white focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <% if @minimum_password_length %>
        <em class="text-xs text-slate-400">(<%= @minimum_password_length %> characters minimum)</em>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "w-full rounded-lg border px-3 py-2 text-slate-900 border-slate-300 bg-white focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-lg border px-3 py-2 text-slate-900 border-slate-300 bg-white focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <%= f.submit "Sign up", class: "w-full bg-indigo-600 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-indigo-500 cursor-pointer" %>
  <% end %>

  <p class="text-sm text-slate-500 mt-6 text-center">
    Already have an account? <%= link_to "Sign in", new_session_path(resource_name), class: "text-indigo-600 font-medium" %>
  </p>
</div>
