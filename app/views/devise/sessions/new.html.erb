<div class="max-w-md mx-auto bg-white rounded-2xl border border-slate-200 p-8 mt-8">
  <h1 class="text-2xl font-bold text-slate-900 mb-6">Sign in</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-lg border px-3 py-2 text-slate-900 border-slate-300 bg-white focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded-lg border px-3 py-2 text-slate-900 border-slate-300 bg-white focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
        <%= f.label :remember_me, class: "text-sm text-slate-600" %>
      </div>
    <% end %>

    <%= f.submit "Sign in", class: "w-full bg-indigo-600 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-indigo-500 cursor-pointer" %>
  <% end %>

  <p class="text-sm text-slate-500 mt-6 text-center">
    Don't have an account? <%= link_to "Sign up", new_registration_path(resource_name), class: "text-indigo-600 font-medium" %>
  </p>
</div>
