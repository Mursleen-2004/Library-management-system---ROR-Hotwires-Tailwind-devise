<nav class="bg-white border-b border-slate-200 sticky top-0 z-10">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex justify-between h-16 items-center">
      <div class="flex items-center gap-8">
        <%= link_to root_path, class: "flex items-center gap-2 text-slate-900 font-semibold text-lg" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
          </svg>
          Library<span class="text-indigo-600">MS</span>
        <% end %>
        <div class="hidden sm:flex gap-6 text-sm font-medium text-slate-600">
          <%= link_to "Books", books_path, class: "hover:text-indigo-600" %>
          <% if user_signed_in? %>
            <%= link_to "My Borrowings", borrowings_path, class: "hover:text-indigo-600" %>
          <% end %>
          <% if user_signed_in? && current_user.admin? %>
            <%= link_to "Authors", authors_path, class: "hover:text-indigo-600" %>
            <%= link_to "Categories", categories_path, class: "hover:text-indigo-600" %>
            <%= link_to "Dashboard", dashboard_path, class: "hover:text-indigo-600" %>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-4 text-sm">
        <% if user_signed_in? %>
          <span class="text-slate-500 hidden sm:inline">
            <%= current_user.name %>
            <span class="ml-1 inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= current_user.admin? ? 'bg-indigo-100 text-indigo-700' : 'bg-slate-100 text-slate-600' %>">
              <%= current_user.role.capitalize %>
            </span>
          </span>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "text-slate-600 hover:text-indigo-600 font-medium" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "text-slate-600 hover:text-indigo-600 font-medium" %>
          <%= link_to "Sign up", new_user_registration_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-indigo-500" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
