<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-slate-900">Categories</h1>
  <%= link_to "+ Add Category", new_category_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-indigo-500 text-sm" %>
</div>

<div class="bg-white rounded-2xl border border-slate-200 divide-y divide-slate-100">
  <% @categories.each do |category| %>
    <div class="flex items-center justify-between p-5">
      <div>
        <p class="font-medium text-slate-900"><%= category.name %></p>
        <p class="text-sm text-slate-500 mt-0.5"><%= category.description %></p>
        <p class="text-xs text-slate-400 mt-1"><%= pluralize(category.books.count, "book") %></p>
      </div>
      <div class="flex gap-2 text-sm">
        <%= link_to "Edit", edit_category_path(category), class: "text-slate-500 hover:text-indigo-600 font-medium" %>
        <%= button_to "Delete", category_path(category), method: :delete,
              form: { data: { turbo_confirm: "Delete this category?" } },
              class: "text-rose-500 hover:text-rose-700 font-medium bg-transparent p-0" %>
      </div>
    </div>
  <% end %>
</div>

<% if @categories.empty? %>
  <div class="text-center py-16 text-slate-400">No categories yet.</div>
<% end %>

<div class="mt-8 flex justify-center"><%= paginate @categories %></div>
