<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Browse Books</h1>
    <p class="text-slate-500 text-sm mt-1"><%= pluralize(@books.total_count, "book") %> in the catalog</p>
  </div>
  <% if user_signed_in? && current_user.admin? %>
    <%= link_to "+ Add Book", new_book_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-indigo-500 text-sm" %>
  <% end %>
</div>

<%= form_with url: books_path, method: :get, class: "grid grid-cols-1 sm:grid-cols-4 gap-3 mb-8 bg-white p-4 rounded-xl border border-slate-200" do %>
  <input type="text" name="keyword" value="<%= params[:keyword] %>" placeholder="Search title or ISBN..."
         class="col-span-2 rounded-lg border px-3 py-2 text-slate-900 border-slate-300 bg-white focus:ring-indigo-500 focus:border-indigo-500 text-sm">
  <select name="category_id" class="rounded-lg border px-3 py-2 text-slate-900 border-slate-300 bg-white focus:ring-indigo-500 focus:border-indigo-500 text-sm">
    <option value="">All Categories</option>
    <% @categories.each do |c| %>
      <option value="<%= c.id %>" <%= "selected" if params[:category_id].to_s == c.id.to_s %>><%= c.name %></option>
    <% end %>
  </select>
  <select name="author_id" class="rounded-lg border px-3 py-2 text-slate-900 border-slate-300 bg-white focus:ring-indigo-500 focus:border-indigo-500 text-sm">
    <option value="">All Authors</option>
    <% @authors.each do |a| %>
      <option value="<%= a.id %>" <%= "selected" if params[:author_id].to_s == a.id.to_s %>><%= a.name %></option>
    <% end %>
  </select>
  <div class="col-span-full flex gap-2">
    <button type="submit" class="bg-slate-900 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-slate-700">Filter</button>
    <%= link_to "Reset", books_path, class: "px-4 py-2 rounded-lg text-sm font-medium text-slate-500 hover:text-slate-800" %>
  </div>
<% end %>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
  <% @books.each do |book| %>
    <%= link_to book_path(book), class: "block bg-white rounded-xl border border-slate-200 p-5 hover:shadow-md hover:border-indigo-200 transition" do %>
      <div class="flex items-start justify-between gap-2">
        <h2 class="font-semibold text-slate-900 leading-snug"><%= book.title %></h2>
        <% if book.available? %>
          <span class="shrink-0 text-xs font-medium bg-emerald-50 text-emerald-700 px-2 py-1 rounded-full">Available</span>
        <% else %>
          <span class="shrink-0 text-xs font-medium bg-rose-50 text-rose-700 px-2 py-1 rounded-full">Checked Out</span>
        <% end %>
      </div>
      <p class="text-sm text-slate-500 mt-1">by <%= book.author.name %></p>
      <p class="text-xs text-slate-400 mt-3"><%= book.category.name %> &middot; <%= book.published_year %></p>
      <p class="text-xs text-slate-400 mt-1"><%= book.available_copies %> / <%= book.total_copies %> copies available</p>
    <% end %>
  <% end %>
</div>

<% if @books.empty? %>
  <div class="text-center py-16 text-slate-400">No books match your search.</div>
<% end %>

<div class="mt-8 flex justify-center">
  <%= paginate @books %>
</div>
