<!DOCTYPE html>
<html>
  <head>
    <title>Library Management System</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">
    <%= render "shared/navbar" %>

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-8">
      <% if notice %>
        <div class="mb-6 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 text-sm">
          <%= notice %>
        </div>
      <% end %>
      <% if alert %>
        <div class="mb-6 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="border-t border-slate-200 py-6 text-center text-sm text-slate-400">
      &copy; <%= Date.current.year %> Library Management System. Built with Ruby on Rails.
    </footer>
  </body>
</html>
